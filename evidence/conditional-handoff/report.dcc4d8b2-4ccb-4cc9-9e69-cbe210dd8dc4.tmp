        "scenario": {
          "id": "vale-revision",
          "version": "1",
          "split": "development",
          "title": "An older procedure for a different revision",
          "ticket": "Lee: My underside label says Vale L4 Air revision B. I need to enter wireless pairing mode. An older leaflet says to hold the wireless button for 8 seconds. Is that right for my printer? I do not want to erase its network settings.",
          "documents": [
            {
              "id": "legacy",
              "version": "1",
              "title": "Revision A wireless leaflet",
              "text": "For L4 Air revision A only, hold the wireless button for 8 seconds until amber to enter pairing mode. Do not apply this procedure to other revisions."
            },
            {
              "id": "revision",
              "version": "1",
              "title": "Revision B correction and priority",
              "text": "The L4 Air revision B supports Wi-Fi. For revision B, this correction supersedes the revision A leaflet. Hold the wireless button for 3 seconds until cyan, then release to enter pairing mode. Holding it for 8 seconds on revision B erases network settings; do not use the revision A timing."
            },
            {
              "id": "policy",
              "version": "1",
              "title": "Pairing support scope",
              "text": "When revision B is confirmed, explain the applicable pairing procedure and the consequence of the old timing. This ticket requests advice only; do not open a handoff. Do not promise a purchase, return, refund, or exchange."
            }
          ],
